This fixes following compilation errors:
	...
	g++ -g -fPIC -O3 -isystem/builddir/build/BUILD/indigo-3.0.4-build/indigo-3.0-4/indigo_libs -I/builddir/build/BUILD/indigo-3.0.4-build/indigo-3.0-4/indigo_drivers -I/builddir/build/BUILD/indigo-3.0.4-build/indigo-3.0-4/indigo_linux_drivers -I/builddir/build/BUILD/indigo-3.0.4-build/indigo-3.0-4/build/include -std=gnu++11 -pthread -DINDIGO_LINUX -I/usr/include/libraw -g -fPIC -O3 -Wall -I../../indigo_libs -I../../indigo_drivers -I/usr/include/libcamera -I/builddir/build/BUILD/indigo-3.0.4-build/indigo-3.0-4/build/include -std=gnu++17 -pthread -DINDIGO_LINUX   -c -o indigo_ccd_rpi.o indigo_ccd_rpi.cpp
