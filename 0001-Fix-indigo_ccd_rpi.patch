	 1667 |                 indigo_define_matching_property(RPI_AF_PROPERTY);
		  |                 ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		  |                 indigo_device_change_property
	...
	gcc -g -fPIC -O3 -isystem/builddir/build/BUILD/indigo-3.0.4-build/indigo-3.0-4/indigo_libs -I/builddir/build/BUILD/indigo-3.0.4-build/indigo-3.0-4/indigo_drivers -I/builddir/build/BUILD/indigo-3.0.4-build/indigo-3.0-4/indigo_linux_drivers -I/builddir/build/BUILD/indigo-3.0.4-build/indigo-3.0-4/build/include -std=gnu11 -pthread -DINDIGO_LINUX -DRPI_MANAGEMENT -I/usr/include/libraw   -c -o indigo_ccd_rpi_main.o indigo_ccd_rpi_main.c
