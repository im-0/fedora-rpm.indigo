From 2e2a4393111314a6b3cc8e3981b5c9e71f75bf3d Mon Sep 17 00:00:00 2001
From: !!!UNSET!!! Dev Container <devcontainer@example.org>
Date: Sun, 23 Aug 2026 22:17:58 +0000
Subject: [PATCH 5/6] Use system dc1394

---
 indigo_drivers/ccd_iidc/Makefile.inc | 16 +---------------
 1 file changed, 1 insertion(+), 15 deletions(-)

diff --git a/indigo_drivers/ccd_iidc/Makefile.inc b/indigo_drivers/ccd_iidc/Makefile.inc
index dbbd478aa..dc59fd7b3 100644
--- a/indigo_drivers/ccd_iidc/Makefile.inc
+++ b/indigo_drivers/ccd_iidc/Makefile.inc
@@ -1,15 +1 @@
-SDK_DIR = externals/libdc1394
-
-SDK_INCLUDE = -I$(SDK_DIR)/build/include
-SDK_LIB = -ldc1394
-SDK_LIB_SO = $(SDK_DIR)/build/lib/libdc1394.$(SOEXT)
-
-MAKE_SDK = $(SDK_LIB_SO)
-SDK_CONFIGURE = $(SDK_DIR)/configure
-SDK_CONFIGURE_IN = $(SDK_DIR)/configure.ac
-
-ifeq ($(OS_DETECTED),Darwin)
-CONFIGURE_FLAGS = LIBUSB_CFLAGS="-I$(BUILD_INCLUDE)/libusb-1.0" LIBUSB_LIBS="-L$(BUILD_LIB) -lusb-1.0"
-endif
-
-FIX_SDK_LIB_DYLIB = install_name_tool -change `otool -L $(SDK_LIB_SO) | grep libusb -m1 | cut -f2 | cut -f1 -d " "` $(BUILD_LIB)/libusb-1.0.dylib $(BUILD_LIB)/$(notdir $(SDK_LIB_SO))
+LDFLAGS += -ldc1394
-- 
