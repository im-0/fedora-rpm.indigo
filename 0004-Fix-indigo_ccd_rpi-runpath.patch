From b2f8653e3083e3e3997276a25c47304bb2a1a568 Mon Sep 17 00:00:00 2001
From: Ivan Mironov <mironov.ivan@gmail.com>
Date: Tue, 25 Aug 2026 04:20:36 +0200
Subject: [PATCH 4/4] Fix indigo_ccd_rpi runpath

---
 indigo_optional_drivers/ccd_rpi/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/indigo_optional_drivers/ccd_rpi/Makefile b/indigo_optional_drivers/ccd_rpi/Makefile
index f2eb62b69e23..f9b71324b1e7 100644
--- a/indigo_optional_drivers/ccd_rpi/Makefile
+++ b/indigo_optional_drivers/ccd_rpi/Makefile
@@ -23,7 +23,7 @@ endif
 ifeq ($(CCD_RPI), 1)
 	CC=gcc
 	CXXFLAGS+=$(DEBUG_BUILD) -fPIC -O3 -Wall -I$(ROOT)/indigo_libs -I$(ROOT)/indigo_drivers $(shell pkg-config --cflags libcamera) -I$(BUILD_INCLUDE) -std=gnu++17 -pthread -DINDIGO_LINUX
-	LDFLAGS=-lm -lstdc++ -ludev -L $(BUILD_LIB) -Wl,-rpath=\$$ORIGIN/../lib,-rpath=\$$ORIGIN/../drivers,-rpath=.
+	LDFLAGS=-lm -lstdc++ -ludev -L $(BUILD_LIB) -Wl,-rpath=\$$ORIGIN/../lib,-rpath=\$$ORIGIN/../drivers
 	SOEXT=so
 	AR=ar
 	ARFLAGS=-rv
